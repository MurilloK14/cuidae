    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^0.453.0",
    "meshoptimizer": "^1.2.0",
    "multer": "^2.4.0",
    "next": "14.2.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
