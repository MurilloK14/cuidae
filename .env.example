# Porta do servidor backend Express
PORT=3001

# Ambiente de execução
NODE_ENV=development

# Google Gemini API
# Obtenha sua chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Infermedica API v3 (Motor de Diagnóstico Clínico)
# Obtenha suas credenciais gratuitas em: https://developer.infermedica.com
INFERMEDICA_APP_ID=seu_app_id_infermedica_aqui
INFERMEDICA_APP_KEY=sua_app_key_infermedica_aqui

# Parâmetros do Loop de Diagnóstico (Entrevista Interativa)
INFERMEDICA_MAX_QUESTIONS=6
INFERMEDICA_CONFIDENCE_THRESHOLD=0.80
INFERMEDICA_DELTA_THRESHOLD=0.35

