# ============================================
# Frontend (Next.js & Supabase)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-supabase

# ============================================
# Backend (Express API & Google Gemini)
# ============================================
PORT=3001
NODE_ENV=development

# Google Gemini API Key (Triagem Inteligente)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Infermedica API (Opcional - Diagnóstico Clínico)
INFERMEDICA_APP_ID=seu_app_id_aqui
INFERMEDICA_APP_KEY=sua_app_key_aqui
